<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="packaging/Commerce.props" />

  <ItemGroup>
    <AssemblyMetadata Include="LemonSqueezyStoreId" Value="$(LemonSqueezyStoreId)" />
    <AssemblyMetadata Include="LemonSqueezyProductId" Value="$(LemonSqueezyProductId)" />
    <AssemblyMetadata Include="LemonSqueezyVariantId" Value="$(LemonSqueezyVariantId)" />
    <AssemblyMetadata Include="LemonSqueezyCheckoutUrl" Value="$(LemonSqueezyCheckoutUrl)" />
  </ItemGroup>
  <Target Name="RequireCommerceConfiguration" BeforeTargets="PrepareForPublish">
    <Error Condition="'$(LemonSqueezyMode)' != 'Live'"
           Text="HYPNIX publication blocked: Lemon Squeezy is in Test mode. Configure and verify Live product values before publishing. Normal builds and tests remain available." />
    <Error Condition="'$(LemonSqueezyStoreId)' == '0' Or '$(LemonSqueezyProductId)' == '0' Or '$(LemonSqueezyVariantId)' == '0' Or '$(LemonSqueezyCheckoutUrl)' == ''"
           Text="HYPNIX publication blocked: configure the live Lemon Squeezy product in packaging/Commerce.props. Normal builds and tests remain available." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(LemonSqueezyStoreId)/$(LemonSqueezyProductId)/$(LemonSqueezyVariantId)', '^[1-9][0-9]*/[1-9][0-9]*/[1-9][0-9]*$'))"
           Text="Lemon Squeezy store, product and variant IDs must be positive numbers." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(LemonSqueezyCheckoutUrl)', '\Ahttps://[a-zA-Z0-9-]+\.lemonsqueezy\.com/(checkout/)?buy/[a-zA-Z0-9-]+\z'))"
           Text="Use the public HTTPS Lemon Squeezy /buy/ or /checkout/buy/ URL, without query parameters. Confirm live mode before publishing." />
  </Target>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>HYPNIX</AssemblyName>
    <!-- SemVer for releases and update comparison. Velopack packs this version; bump it per release. -->
    <Version>1.1.1</Version>
    <!-- Velopack needs a custom Main (App.xaml becomes a Page below), so name the entry point. -->
    <StartupObject>AnimatedWallPaper.App</StartupObject>
    <Authors>Marcelo Bossle</Authors>
    <Company>Marcelo Bossle</Company>
    <Copyright>Copyright (c) 2026 Marcelo Bossle. Todos os direitos reservados.</Copyright>
    <RootNamespace>AnimatedWallPaper</RootNamespace>
    <ApplicationIcon>Assets\Brand\hypnix-v2.ico</ApplicationIcon>
    <!-- Static analysis: surface resource/dispose/interop defects at build time.
         Warnings only (no TreatWarningsAsErrors) so they inform without breaking the build. -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

  <!-- Velopack WPF bootstrap: App.xaml is a Page so the compiler does not generate Main; our
       custom [STAThread] Main in App.xaml.cs runs VelopackApp.Build().Run() before the app starts. -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="Velopack" Version="1.2.0" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets\Brand\hypnix-icon.png" />
    <Resource Include="Assets\Brand\hypnix-icon-v2.png" />
    <Resource Include="Assets\Brand\hypnix-v2.ico" />
    <Resource Include="Assets\Brand\hypnix-tray-white.png" />
    <Resource Include="Assets\Wallpapers\**\preview.jpg" />
    <Resource Include="Assets\Wallpapers\**\preview.png" />
    <Content Include="Assets\Wallpapers\**\preview.jpg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Wallpapers\**\preview.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Brand\hypnix.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Brand\hypnix-tray-white.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Wallpapers\**\wallpaper.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Wallpapers\**\CREDITS.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Wallpapers\**\background.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Wallpapers\**\*-state.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Shaders\**\*.hlsl" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Effects\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="NativeBin\Hypnix.EffekseerBridge.dll" Link="Hypnix.EffekseerBridge.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
