<Window x:Class="AnimatedWallPaper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AnimatedWallPaper"
        Title="HYPNIX" Icon="pack://application:,,,/HYPNIX;component/Assets/Brand/hypnix-v2.ico"
        Width="1180" Height="760" MinWidth="800" MinHeight="600"
        WindowStartupLocation="Manual" Loaded="MainWindow_Loaded"
        Background="#0B0E13" Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable, Segoe UI">
    <Window.Resources>
        <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="38"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" BorderThickness="2" BorderBrush="Transparent" CornerRadius="8">
                            <Grid>
                                <ContentPresenter/>
                                <TextBlock x:Name="SelectedMark" Visibility="Collapsed" Text="✓" FontSize="20"
                                           Background="#D0101925" Padding="5,0" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="SelectedMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel Orientation="Horizontal">
                <Image Width="48" Height="48" Source="Assets/Brand/hypnix-icon-v2.png" Margin="0,0,12,0"/>
                <StackPanel>
                    <TextBlock Text="HYPNIX" FontSize="27" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StatusText" Text="Stopped" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="StartButton" Content="Start" Click="StartButton_Click"/>
                <Button x:Name="StopButton" Content="Stop" Click="StopButton_Click" Margin="0"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border BorderBrush="#35404D" BorderThickness="1" Background="#07090D">
                    <local:WallpaperPreviewControl x:Name="LivePreview"/>
                </Border>
                <StackPanel Grid.Row="1" Margin="0,12,0,14">
                    <TextBlock x:Name="ActivePreviewTitle" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ActivePreviewSubtitle" Margin="0,4,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="PreviewStatusText" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
                <StackPanel Grid.Row="2">
                    <TextBlock Text="Wallpapers" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <ListBox x:Name="WallpaperGallery" Background="Transparent" BorderThickness="0"
                             SelectionChanged="WallpaperGallery_SelectionChanged" Height="132"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="Wallpaper library">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="168" Height="104" Background="#161C26" ToolTip="{Binding Title}">
                                    <Image Source="{Binding PreviewPath}" Stretch="UniformToFill"/>
                                    <Border Background="#CF0B1018" VerticalAlignment="Bottom" Padding="8">
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Grid>
            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="Controls" FontSize="19" FontWeight="SemiBold"/>
                            <Button x:Name="VisualizerSettingsButton" Style="{StaticResource IconButtonStyle}"
                                    HorizontalAlignment="Right" Visibility="Collapsed" Content="⚙"
                                    ToolTip="Audio visualizer settings" AutomationProperties.Name="Audio visualizer settings"
                                    Click="VisualizerSettingsButton_Click"/>
                        </Grid>
                        <TextBlock Text="Pause animation for apps" Margin="0,0,0,6"/>
                        <ComboBox x:Name="AppPauseModeComboBox" Margin="0,0,0,14" SelectionChanged="PolicyModeChanged"
                                  AutomationProperties.Name="Pause animation for apps">
                            <ComboBoxItem Content="Never"/>
                            <ComboBoxItem Content="Fullscreen apps only"/>
                            <ComboBoxItem Content="Maximized or fullscreen apps"/>
                        </ComboBox>
                        <TextBlock Text="Pause scope" Margin="0,0,0,6"/>
                        <ComboBox x:Name="PauseScopeComboBox" Margin="0,0,0,14" SelectionChanged="PolicyModeChanged"
                                  AutomationProperties.Name="Pause scope">
                            <ComboBoxItem Content="All displays"/>
                            <ComboBoxItem Content="Active display only"/>
                        </ComboBox>
                        <CheckBox x:Name="PauseBatteryCheckBox" Content="Pause on battery" Checked="PolicyChanged" Unchecked="PolicyChanged"/>
                        <TextBlock Text="Frame cap" Margin="0,0,0,6"/>
                        <ComboBox x:Name="FpsComboBox" SelectionChanged="FpsComboBox_SelectionChanged" AutomationProperties.Name="Frame cap">
                            <ComboBoxItem Content="15 FPS" Tag="15"/>
                            <ComboBoxItem Content="30 FPS" Tag="30"/>
                            <ComboBoxItem Content="60 FPS" Tag="60"/>
                        </ComboBox>
                        <Separator Margin="0,18"/>
                        <Button Content="Add local video…" Click="AddVideo_Click" Margin="0,0,0,8"/>
                        <Button Content="Open library folder" Click="OpenLibrary_Click" Margin="0,0,0,8"/>
                        <Button Content="Media tools…" Click="MediaTools_Click" Margin="0,0,0,8"/>
                        <Button Content="Open diagnostics" Click="OpenDiagnostics_Click" Margin="0,0,0,8"/>
                        <TextBlock x:Name="LibraryStatusText" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <TextBlock x:Name="ErrorText" Grid.Row="3" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#FFB9A5"
                   AutomationProperties.LiveSetting="Polite"/>
        <Popup x:Name="VisualizerSettingsPopup" PlacementTarget="{Binding ElementName=VisualizerSettingsButton}"
               Placement="Left" StaysOpen="False" AllowsTransparency="True">
            <Border Width="270" Margin="8" Padding="16" Background="#1D232B" BorderBrush="#3B4652" BorderThickness="1" CornerRadius="10">
                <StackPanel>
                    <TextBlock Text="Audio visualizer" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="Saved for this wallpaper." Margin="0,4,0,14" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="Intensity"/>
                    <Slider x:Name="VisualizerIntensitySlider" Minimum="0.35" Maximum="2.7" Value="1" Margin="0,4,0,12"
                            ValueChanged="VisualizerSettingChanged" AutomationProperties.Name="Intensity"/>
                    <TextBlock Text="Audio sensitivity"/>
                    <Slider x:Name="VisualizerSensitivitySlider" Minimum="0.4" Maximum="2.5" Value="1" Margin="0,4,0,12"
                            ValueChanged="VisualizerSettingChanged" AutomationProperties.Name="Audio sensitivity"/>
                    <TextBlock Text="Glow"/>
                    <Slider x:Name="VisualizerGlowSlider" Minimum="0" Maximum="1" Value="0.55" Margin="0,4,0,12"
                            ValueChanged="VisualizerSettingChanged" AutomationProperties.Name="Glow"/>
                    <TextBlock Text="Color theme" Margin="0,0,0,6"/>
                    <ComboBox x:Name="VisualizerColorComboBox" SelectionChanged="VisualizerColorChanged" AutomationProperties.Name="Color theme">
                        <ComboBoxItem Content="Ice blue"/><ComboBoxItem Content="Neon sunset"/>
                        <ComboBoxItem Content="Emerald"/><ComboBoxItem Content="Monochrome"/>
                    </ComboBox>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
