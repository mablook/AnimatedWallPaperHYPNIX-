<Window x:Class="AnimatedWallPaper.MainWindow" x:Name="Shell"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:AnimatedWallPaper" xmlns:controls="clr-namespace:AnimatedWallPaper.Controls"
 Title="HYPNIX" Icon="pack://application:,,,/HYPNIX;component/Assets/Brand/hypnix-v2.ico"
 Width="1280" Height="820" MinWidth="640" MinHeight="520" Loaded="MainWindow_Loaded" WindowStartupLocation="Manual"
 Background="{StaticResource WindowBackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Window.Resources>
  <controls:ActiveWallpaperConverter x:Key="IsActiveWallpaper"/>
  <Style x:Key="LibraryCardStyle" TargetType="ListBoxItem">
   <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
   <Setter Property="Margin" Value="6,0,6,12"/><Setter Property="Padding" Value="0"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="Card" CornerRadius="3" Background="{StaticResource CardBrush}" BorderBrush="#2B2F35" BorderThickness="1">
     <Grid><ContentPresenter/><Border x:Name="SelectedMark" Visibility="Collapsed" CornerRadius="3" Background="{StaticResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Padding="6,1"><TextBlock Text="✓" Foreground="{StaticResource AccentTextBrush}" FontWeight="Bold"/></Border></Grid>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter TargetName="SelectedMark" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="{StaticResource PanelAltBrush}"/></Trigger>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource TextPrimaryBrush}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SettingsCard" TargetType="Border"><Setter Property="Background" Value="{StaticResource PanelBrush}"/><Setter Property="BorderBrush" Value="#2B2F35"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="3"/><Setter Property="Padding" Value="24"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
 </Window.Resources>
 <Grid x:Name="ShellRoot" Margin="24" SizeChanged="ShellRoot_SizeChanged">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="24"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Grid Margin="0,0,16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Image Source="Assets/Brand/hypnix-icon-v2.png" Width="36" Height="36" Margin="0,0,12,0"/>
    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="HYPNIX" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="StatusText" Text="Stopped" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/></StackPanel>
   </Grid>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
    <Button x:Name="StopButton" Content="Stop all" Click="StopButton_Click" MinWidth="68" Style="{StaticResource QuietButtonStyle}"/>
    <Button x:Name="AppSettingsButton" Content="App settings" Click="AppSettings_Click" Margin="0" Style="{StaticResource QuietButtonStyle}"/>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="2">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
   <Border x:Name="LicenseBanner" Visibility="Collapsed" Background="#171D22" BorderBrush="#30414B" BorderThickness="1" CornerRadius="3" Padding="16,12" Margin="0,0,0,24">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock x:Name="LicenseBannerTitle" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/><TextBlock x:Name="LicenseBannerDetail" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel>
     <Button x:Name="LicenseBuyButton" Grid.Column="1" Content="Buy HYPNIX" Click="BuyLicense_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0" VerticalAlignment="Center"/>
    </Grid>
   </Border>
   <Grid x:Name="WorkspacePages" Grid.Row="1">
   <Grid x:Name="LibraryWorkspace">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid x:Name="DisplayTargetBar" Margin="0,0,0,20">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <ComboBox x:Name="TargetDisplayCombo" Width="218" DisplayMemberPath="Label" SelectionChanged="PreviewDisplay_SelectionChanged" AutomationProperties.Name="Display to change" ToolTip="Choose which display receives the wallpaper and its settings."/>
     <TextBlock x:Name="DisplayWallpaperText" Grid.Column="1" Margin="16,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
     <Button x:Name="StopDisplayButton" Grid.Column="2" Content="Stop this display" Click="StopDisplay_Click" Style="{StaticResource QuietButtonStyle}" Margin="0"/>
    </Grid>
    <Grid x:Name="BrowseLayout" Grid.Row="1">
     <Grid.ColumnDefinitions><ColumnDefinition x:Name="LibraryColumn" Width="*"/><ColumnDefinition x:Name="PreviewGap" Width="0"/><ColumnDefinition x:Name="PreviewColumn" Width="0"/></Grid.ColumnDefinitions>
     <Grid x:Name="LibraryPanel">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,20">
       <Button DockPanel.Dock="Right" Content="Add video…" Click="AddVideo_Click" Margin="0"/>
       <StackPanel><TextBlock Text="Your wallpapers" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="LibraryStatusText" Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel>
      </DockPanel>
      <ListBox x:Name="WallpaperGallery" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0" Margin="-6,0,-6,0" ItemContainerStyle="{StaticResource LibraryCardStyle}"
       SelectionChanged="WallpaperGallery_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
       ScrollViewer.CanContentScroll="False" AutomationProperties.Name="Wallpaper library">
       <ListBox.ItemsPanel><ItemsPanelTemplate><controls:LibraryWrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
       <ListBox.ItemTemplate><DataTemplate>
        <Grid Height="188"><Grid.RowDefinitions><RowDefinition Height="122"/><RowDefinition Height="*"/></Grid.RowDefinitions>
         <Border CornerRadius="3,3,0,0" Background="{StaticResource CardBrush}" ClipToBounds="True"><Image Source="{Binding PreviewPath}" Stretch="Uniform"/></Border>
         <StackPanel Grid.Row="1" Margin="12,9,12,8"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/><TextBlock Text="{Binding Description}" FontSize="11" Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/></StackPanel>
         <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="7,3" CornerRadius="3" Background="{StaticResource PanelBrush}">
          <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Value="True"><DataTrigger.Binding><MultiBinding Converter="{StaticResource IsActiveWallpaper}"><Binding Path="Id"/><Binding Path="ActiveWallpaperId" RelativeSource="{RelativeSource AncestorType=Window}"/></MultiBinding></DataTrigger.Binding><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
          <TextBlock Text="● ON THIS DISPLAY" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
         </Border>
        </Grid>
       </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </Grid>
     <Border x:Name="PreviewPanel" Grid.Column="2" Visibility="Collapsed" BorderBrush="#2B2F35" BorderThickness="1,0,0,0" Padding="24,0,0,0">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <DockPanel Margin="0,0,0,20"><Button x:Name="ClosePreviewButton" Content="Hide preview" DockPanel.Dock="Right" Click="ClosePreview_Click" MinWidth="100" Margin="0" Style="{StaticResource QuietButtonStyle}"/><TextBlock Text="Preview" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
       <Grid Grid.Row="1" Margin="0,0,0,14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Canvas x:Name="MonitorMap" Height="72" SizeChanged="MonitorMap_SizeChanged" AutomationProperties.Name="Display arrangement"/>
        <ComboBox x:Name="PreviewDisplayCombo" Grid.Row="1" DisplayMemberPath="Label" SelectionChanged="PreviewDisplay_SelectionChanged" AutomationProperties.Name="Display shown in preview" ToolTip="Select the display to preview, customize and apply to."/>
       </Grid>
       <Border Grid.Row="2" Background="#080808" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1"><controls:AspectRatioDecorator x:Name="PreviewAspect"><local:WallpaperPreviewControl x:Name="LivePreview"/></controls:AspectRatioDecorator></Border>
       <StackPanel Grid.Row="3" Margin="0,12,0,0"><TextBlock x:Name="PreviewStatusText" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Text="Preview only · your desktop changes when you apply" Margin="0,5,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel>
      </Grid>
     </Border>
    </Grid>
    <Border Grid.Row="2" BorderBrush="#2B2F35" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,16,0,0">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
       <TextBlock Text="SELECTED WALLPAPER" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
       <TextBlock x:Name="ActivePreviewTitle" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self},Path=Text}"/>
       <TextBlock x:Name="ActivePreviewSubtitle" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
      </StackPanel>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
       <StackPanel Orientation="Horizontal">
        <Button x:Name="PreviewButton" Content="Preview" Click="Preview_Click" MinWidth="80" Padding="12,0"/>
        <Button x:Name="VisualizerSettingsButton" Content="Customize" Click="VisualizerSettingsButton_Click" Visibility="Collapsed" AutomationProperties.Name="Customize wallpaper" MinWidth="94" Padding="14,0"/>
        <Button x:Name="StartButton" Content="Apply wallpaper" Click="StartButton_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0" MinWidth="144"/>
       </StackPanel>
       <DockPanel Margin="0,4,0,0"><Button x:Name="ApplyAllButton" DockPanel.Dock="Right" Content="Apply to all displays" Click="ApplyAll_Click" Style="{StaticResource QuietButtonStyle}" Height="28" FontSize="11" Padding="8,0" Margin="8,0,0,0"/><TextBlock x:Name="ApplyTargetText" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/></DockPanel>
      </StackPanel>
     </Grid>
    </Border>
   </Grid>
   <Grid x:Name="AppSettingsPage" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,18"><Button Content="Back to library" DockPanel.Dock="Right" Click="BackToLibrary_Click" Margin="0"/><StackPanel><TextBlock Text="App settings" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Playback preferences for every wallpaper" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0"/></StackPanel></DockPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel MaxWidth="720" HorizontalAlignment="Stretch">
      <Border x:Name="LicenseSettingsCard" Visibility="Collapsed" Style="{StaticResource SettingsCard}"><StackPanel>
       <TextBlock Text="Your license" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12"/>
       <TextBlock x:Name="LicenseSettingsTitle" FontWeight="SemiBold" TextWrapping="Wrap"/>
       <TextBlock x:Name="LicenseSettingsDetail" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,14"/>
       <WrapPanel><Button x:Name="LicenseSettingsBuyButton" Content="Buy HYPNIX" Click="BuyLicense_Click" Style="{StaticResource PrimaryButtonStyle}"/><Button x:Name="LicenseCheckButton" Content="Check license" Click="CheckLicense_Click"/></WrapPanel>
       <TextBlock x:Name="LicenseNoticeText" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
      </StackPanel></Border>
      <Border Style="{StaticResource SettingsCard}"><StackPanel>
       <TextBlock Text="Playback &amp; power" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,16"/>
       <TextBlock Text="Pause for other apps" Margin="0,0,0,6"/>
       <ComboBox x:Name="AppPauseModeComboBox" SelectionChanged="PolicyModeChanged" AutomationProperties.Name="Pause animation for apps" ToolTip="Never keeps the wallpaper animating even while other apps cover it."><ComboBoxItem Content="Never"/><ComboBoxItem Content="Fullscreen apps only"/><ComboBoxItem Content="Maximized or fullscreen apps"/></ComboBox>
       <CheckBox x:Name="PausePerMonitorToggle" Content="Pause only the display in use" Style="{StaticResource ToggleSwitchStyle}" Margin="0,18,0,12" Checked="PolicyChanged" Unchecked="PolicyChanged" ToolTip="Other displays keep animating. When off, a covering app pauses every display."/>
       <CheckBox x:Name="PauseBatteryCheckBox" Content="Pause on battery" Checked="PolicyChanged" Unchecked="PolicyChanged"/>
       <TextBlock Text="Frame cap" Margin="0,18,0,6"/><ComboBox x:Name="FpsComboBox" SelectionChanged="FpsComboBox_SelectionChanged" AutomationProperties.Name="Frame cap"><ComboBoxItem Content="15 FPS" Tag="15"/><ComboBoxItem Content="30 FPS" Tag="30"/><ComboBoxItem Content="60 FPS" Tag="60"/></ComboBox>
      </StackPanel></Border>
      <Border Style="{StaticResource SettingsCard}"><StackPanel><TextBlock Text="Sound" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,16"/><CheckBox x:Name="AudioReactiveCheckBox" Content="Audio reactive" Style="{StaticResource ToggleSwitchStyle}" Checked="AudioReactiveChanged" Unchecked="AudioReactiveChanged" AutomationProperties.Name="Audio reactive" ToolTip="When off, animation continues without capturing system audio."/></StackPanel></Border>
      <Border Style="{StaticResource SettingsCard}"><StackPanel><TextBlock Text="Library &amp; tools" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,16"/><WrapPanel><Button Content="Open library folder" Click="OpenLibrary_Click" Margin="0,0,8,8"/><Button Content="Media tools…" Click="MediaTools_Click" Margin="0,0,8,8"/><Button Content="Open diagnostics" Click="OpenDiagnostics_Click" Margin="0,0,0,8"/></WrapPanel></StackPanel></Border>
     </StackPanel>
    </ScrollViewer>
   </Grid>
   <ScrollViewer x:Name="LicenseGatePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Border MaxWidth="620" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource PanelBrush}" BorderBrush="#2B2F35" BorderThickness="1" CornerRadius="3" Padding="32" Margin="0,16">
     <StackPanel>
      <TextBlock Text="HYPNIX" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,18"/>
      <TextBlock x:Name="LicenseGateTitle" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock x:Name="LicenseGateDetail" Foreground="{StaticResource TextSecondaryBrush}" FontSize="15" TextWrapping="Wrap" Margin="0,12,0,20"/>
      <StackPanel x:Name="LicenseGateBenefits" Margin="0,0,0,24">
       <TextBlock Text="All wallpapers and customization" Margin="0,0,0,8"/>
       <TextBlock Text="Audio reactive effects and multi-monitor support" TextWrapping="Wrap" Margin="0,0,0,8"/>
       <TextBlock Text="One-time purchase · No subscription" Foreground="{StaticResource AccentBrush}"/>
      </StackPanel>
      <WrapPanel><Button x:Name="LicenseGateBuyButton" Content="Buy HYPNIX" Click="BuyLicense_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,12,8"/><Button x:Name="LicenseGateCheckButton" Content="Check license" Click="CheckLicense_Click" Margin="0,0,0,8"/></WrapPanel>
      <TextBlock x:Name="LicenseGateNotice" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
     </StackPanel>
    </Border>
   </ScrollViewer>
   </Grid>
  </Grid>
  <TextBlock x:Name="ErrorText" Grid.Row="3" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource ErrorTextBrush}" AutomationProperties.LiveSetting="Polite"/>
 </Grid>
</Window>
