<Application x:Class="AnimatedWallPaper.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AnimatedWallPaper"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#15191F"/>
        <SolidColorBrush x:Key="PanelAltBrush" Color="#1D232B"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#3CC2FF"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F5F7FA"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#AEB7C2"/>

        <Style TargetType="{x:Type Button}">
            <Setter Property="MinWidth" Value="112"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Foreground" Value="#F5F7FA"/>
            <Setter Property="Background" Value="#2A323C"/>
            <Setter Property="BorderBrush" Value="#3B4652"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Application.Resources>
</Application>
