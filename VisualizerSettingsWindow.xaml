<Window x:Class="AnimatedWallPaper.VisualizerSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Visualizer settings" Width="420" Height="720" MinWidth="360" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#0F141B" Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable, Segoe UI">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#111820"/>
            <Setter Property="Foreground" Value="#F1F5FA"/>
            <Setter Property="BorderBrush" Value="#48586B"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>
        <Style x:Key="GroupLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Visualizer settings" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock x:Name="WallpaperNameText" Margin="0,2,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel>
                <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="16" Margin="0,0,0,14"
                        BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="APPEARANCE" Style="{StaticResource GroupLabel}"/>

                        <TextBlock Text="Color theme" Margin="0,0,0,6"/>
                        <ComboBox x:Name="ColorComboBox" SelectionChanged="OnComboChanged" AutomationProperties.Name="Color theme">
                            <ComboBoxItem Content="Ice blue"/><ComboBoxItem Content="Neon sunset"/>
                            <ComboBoxItem Content="Emerald"/><ComboBoxItem Content="Monochrome"/>
                        </ComboBox>
                        <TextBlock Text="Palette used for the wallpaper." Style="{StaticResource Hint}" Margin="0,6,0,18"/>

                        <DockPanel>
                            <TextBox Width="72" DockPanel.Dock="Right" Text="{Binding ElementName=SizeSlider, Path=Value, Mode=TwoWay, StringFormat=F2, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" AutomationProperties.Name="Size value"/>
                            <TextBlock Text="Size · 0.3–3" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Slider x:Name="SizeSlider" Minimum="0.3" Maximum="3" Value="1" Margin="0,10,0,6" SmallChange="0.05" LargeChange="0.25"
                                AutoToolTipPlacement="BottomRight" AutoToolTipPrecision="2"
                                ValueChanged="OnControlChanged" AutomationProperties.Name="Size"/>
                        <TextBlock Text="Zoom the animation in or out." Style="{StaticResource Hint}"/>

                        <DockPanel>
                            <TextBox Width="72" DockPanel.Dock="Right" Text="{Binding ElementName=PositionXSlider, Path=Value, Mode=TwoWay, StringFormat=F2, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" AutomationProperties.Name="Horizontal position value"/>
                            <TextBlock Text="Position X · -1–1" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Slider x:Name="PositionXSlider" Minimum="-1" Maximum="1" Value="0" Margin="0,10,0,6" SmallChange="0.02" LargeChange="0.1"
                                AutoToolTipPlacement="BottomRight" AutoToolTipPrecision="2"
                                ValueChanged="OnControlChanged" AutomationProperties.Name="Horizontal position"/>
                        <TextBlock Text="Move the animation left or right." Style="{StaticResource Hint}"/>

                        <DockPanel>
                            <TextBox Width="72" DockPanel.Dock="Right" Text="{Binding ElementName=PositionYSlider, Path=Value, Mode=TwoWay, StringFormat=F2, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" AutomationProperties.Name="Vertical position value"/>
                            <TextBlock Text="Position Y · -1–1" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Slider x:Name="PositionYSlider" Minimum="-1" Maximum="1" Value="0" Margin="0,10,0,6" SmallChange="0.02" LargeChange="0.1"
                                AutoToolTipPlacement="BottomRight" AutoToolTipPrecision="2"
                                ValueChanged="OnControlChanged" AutomationProperties.Name="Vertical position"/>
                        <TextBlock Text="Move the animation up or down." Style="{StaticResource Hint}"/>

                        <DockPanel>
                            <TextBox Width="72" DockPanel.Dock="Right" Text="{Binding ElementName=GlowSlider, Path=Value, Mode=TwoWay, StringFormat=F2, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" AutomationProperties.Name="Glow value"/>
                            <TextBlock Text="Glow · 0–3" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Slider x:Name="GlowSlider" Minimum="0" Maximum="3" Value="1.2" Margin="0,10,0,6" SmallChange="0.05" LargeChange="0.25"
                                AutoToolTipPlacement="BottomRight" AutoToolTipPrecision="2"
                                ValueChanged="OnControlChanged" AutomationProperties.Name="Glow"/>
                        <TextBlock Text="Light spread and glow strength." Style="{StaticResource Hint}"/>

                        <DockPanel>
                            <TextBox Width="72" DockPanel.Dock="Right" Text="{Binding ElementName=IntensitySlider, Path=Value, Mode=TwoWay, StringFormat=F2, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" AutomationProperties.Name="Intensity value"/>
                            <TextBlock Text="Intensity · 0–8" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Slider x:Name="IntensitySlider" Minimum="0" Maximum="8" Value="3" Margin="0,10,0,6" SmallChange="0.05" LargeChange="0.5"
                                AutoToolTipPlacement="BottomRight" AutoToolTipPrecision="2"
                                ValueChanged="OnControlChanged" AutomationProperties.Name="Intensity"/>
                        <TextBlock Text="Overall visual strength (0 turns it off)." Style="{StaticResource Hint}" Margin="0,0,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="16"
                        BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="AUDIO" Style="{StaticResource GroupLabel}"/>
                        <DockPanel>
                            <TextBox Width="72" DockPanel.Dock="Right" Text="{Binding ElementName=SensitivitySlider, Path=Value, Mode=TwoWay, StringFormat=F2, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" AutomationProperties.Name="Audio sensitivity value"/>
                            <TextBlock Text="Audio sensitivity · 0–12" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Slider x:Name="SensitivitySlider" Minimum="0" Maximum="12" Value="4" Margin="0,10,0,6" SmallChange="0.1" LargeChange="1"
                                AutoToolTipPlacement="BottomRight" AutoToolTipPrecision="2"
                                ValueChanged="OnControlChanged" AutomationProperties.Name="Audio sensitivity"/>
                        <TextBlock Text="More response to quiet music; 0 disables audio reaction." Style="{StaticResource Hint}" Margin="0,0,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2" Content="Reset this wallpaper" Click="Reset_Click" Margin="0,16,0,0"/>
    </Grid>
</Window>
